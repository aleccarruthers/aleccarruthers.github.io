---
interface Props {
  publication: { title: string; authors: string; venue: string | null; date: string; url: string | null };
}
const { publication: paper } = Astro.props;
const authorParts = paper.authors.split(/(Alec Carruthers|Carruthers A)/);
---
<li class="entry publication">
  <p class="meta">{paper.date}</p>
  <h3>{paper.title}</h3>
  <p class="meta">{authorParts.map(part => part === 'Alec Carruthers' || part === 'Carruthers A' ? <strong>{part}</strong> : part)}</p>
  {paper.venue && <p class="meta"><em>{paper.venue}</em></p>}
  {paper.url && <div class="entry-links"><a href={paper.url}>Paper</a></div>}
</li>
